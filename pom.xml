<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>tech.erben</groupId>
    <artifactId>java17-course</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Java 17 Course</name>
    <description>Guided one-day Java 17 course modules</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <modules>
        <module>assignments</module>
        <module>solutions</module>
    </modules>

    <profiles>
        <profile>
            <id>run-all</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-invoker-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>start-all</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <parallel>false</parallel>
                                    <invocations>
                                        <invocation>
                                            <projects>trainer</projects>
                                            <goals>
                                                <goal>spring-boot:start</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>assignments/records-car-dealership</projects>
                                            <goals>
                                                <goal>spring-boot:start</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>assignments/text-blocks-barbershop</projects>
                                            <goals>
                                                <goal>spring-boot:start</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>assignments/food-delivery-modern-java</projects>
                                            <goals>
                                                <goal>spring-boot:start</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>assignments/sealed-classes-insurance</projects>
                                            <goals>
                                                <goal>spring-boot:start</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>assignments/enhanced-npe-helpdesk</projects>
                                            <goals>
                                                <goal>spring-boot:start</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>assignments/random-generator-raffle</projects>
                                            <goals>
                                                <goal>spring-boot:start</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>solutions/records-car-dealership-solution</projects>
                                            <goals>
                                                <goal>spring-boot:start</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>solutions/text-blocks-barbershop-solution</projects>
                                            <goals>
                                                <goal>spring-boot:start</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>solutions/food-delivery-modern-java-solution</projects>
                                            <goals>
                                                <goal>spring-boot:start</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>solutions/sealed-classes-insurance-solutions</projects>
                                            <goals>
                                                <goal>spring-boot:start</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>solutions/enhanced-npe-helpdesk-solution</projects>
                                            <goals>
                                                <goal>spring-boot:start</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>solutions/random-generator-raffle-solution</projects>
                                            <goals>
                                                <goal>spring-boot:start</goal>
                                            </goals>
                                        </invocation>
                                    </invocations>
                                </configuration>
                            </execution>
                            <execution>
                                <id>stop-all</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <parallel>false</parallel>
                                    <invocations>
                                        <invocation>
                                            <projects>solutions/random-generator-raffle-solution</projects>
                                            <goals>
                                                <goal>spring-boot:stop</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>solutions/enhanced-npe-helpdesk-solution</projects>
                                            <goals>
                                                <goal>spring-boot:stop</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>solutions/sealed-classes-insurance-solutions</projects>
                                            <goals>
                                                <goal>spring-boot:stop</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>solutions/food-delivery-modern-java-solution</projects>
                                            <goals>
                                                <goal>spring-boot:stop</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>solutions/text-blocks-barbershop-solution</projects>
                                            <goals>
                                                <goal>spring-boot:stop</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>solutions/records-car-dealership-solution</projects>
                                            <goals>
                                                <goal>spring-boot:stop</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>assignments/random-generator-raffle</projects>
                                            <goals>
                                                <goal>spring-boot:stop</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>assignments/enhanced-npe-helpdesk</projects>
                                            <goals>
                                                <goal>spring-boot:stop</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>assignments/sealed-classes-insurance</projects>
                                            <goals>
                                                <goal>spring-boot:stop</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>assignments/food-delivery-modern-java</projects>
                                            <goals>
                                                <goal>spring-boot:stop</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>assignments/text-blocks-barbershop</projects>
                                            <goals>
                                                <goal>spring-boot:stop</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>assignments/records-car-dealership</projects>
                                            <goals>
                                                <goal>spring-boot:stop</goal>
                                            </goals>
                                        </invocation>
                                        <invocation>
                                            <projects>trainer</projects>
                                            <goals>
                                                <goal>spring-boot:stop</goal>
                                            </goals>
                                        </invocation>
                                    </invocations>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
