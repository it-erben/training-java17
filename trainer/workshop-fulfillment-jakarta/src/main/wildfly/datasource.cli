if (outcome == success) of /subsystem=datasources/data-source=FulfillmentDS:read-resource
    /subsystem=datasources/data-source=FulfillmentDS:remove()
end-if

data-source add --name=FulfillmentDS \
    --jndi-name=java:jboss/datasources/FulfillmentDS \
    --driver-name=h2 \
    --connection-url=jdbc:h2:mem:fulfillment;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE \
    --user-name=sa \
    --password=sa \
    --jta=true \
    --enabled=true \
    --statistics-enabled=true
